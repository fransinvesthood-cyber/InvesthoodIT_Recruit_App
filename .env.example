# --- App ---
APP_ENV=development
APP_URL=http://localhost/InvesthoodIT_Recruit_App
APP_TIMEZONE=Africa/Johannesburg

# --- Database ---
DB_HOST=127.0.0.1
DB_NAME=investhood_platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Password reset ---
PASSWORD_RESET_EXPIRY_MINUTES=30

# --- Mail (SMTP via PHPMailer) ---
# Set MAIL_ENABLED=true once SMTP is configured. Keep this file
# out of version control — never commit real credentials.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@investhoodit.co.za
MAIL_FROM_NAME="Investhood IT"
MAIL_ENCRYPTION=tls

# --- HTTPS cookies (set true in production) ---
COOKIE_SECURE=false
