# Copy to .env and set real values. Never commit the real .env file.
APP_ENV=production
APP_URL=http://localhost/recruitment-project
APP_TIMEZONE=Africa/Johannesburg

DB_HOST=localhost
DB_NAME=investhood_platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Keep true for HTTPS production. Set false only for local HTTP development.
COOKIE_SECURE=false

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Investhood IT
MAIL_ENCRYPTION=tls

# Optional: comma-separated exact IP addresses of trusted reverse proxies.
# Leave blank unless the server/network team has confirmed the proxy addresses.
TRUSTED_PROXY_IPS=
